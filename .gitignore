coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Design-tool and browser-automation output (inspector screenshots, reports,
# page snapshots). Regenerated on demand; 25 MB of it reached the first commit.
# direction.json is the exception: it records the dealt design direction the
# whole site is built on (seed, motif, palette), and it is 29 KB.
.taste-skill/*
!.taste-skill/direction.json
.playwright-mcp/

# Screenshot scratch dropped at the project root during review passes.
# Real images live under client/public/images.
/*.png

# Archives of the project itself. The repo is the source of truth, not a zip
# snapshot of it.
*.zip

# Local development credentials (seeded dev accounts, local database only).
# Never committed: these exist so the local XAMPP/Laravel setup can be signed
# into during development. They are not real user data and not production.
*.local.txt
